{
  "name": "threads-private-api",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "Unofficial Node.js SDK for controlled Threads direct messaging",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "git+https://github.com/anhbipro144/threads-private-api.git" },
  "homepage": "https://github.com/anhbipro144/threads-private-api#readme",
  "bugs": { "url": "https://github.com/anhbipro144/threads-private-api/issues" },
  "keywords": ["threads", "direct-messages", "sdk", "typescript"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "docs/usage-guide", "docs/incoming-sdk.md", "docs/session-recovery.md", "docs/website-read-handler.md", "docs/website-send-handler.md", "examples"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": { "node": "^24.22.1" },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.ts",
    "prepack": "npm run build",
    "verify:package": "node scripts/verification/package-smoke.mjs",
    "lint": "tsc --noEmit",
    "verify:mcp": "node scripts/verification/mcp-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "chrome-devtools-mcp": "1.12.0",
    "node": "24.22.1",
    "rea-agents": "6.8.0",
    "typescript": "6.0.3"
  }
}
